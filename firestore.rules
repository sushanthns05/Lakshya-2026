rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the user is an authenticated administrator
    function isAdmin() {
      return request.auth != null;
    }

    // REGISTRATIONS COLLECTION
    match /registrations/{registrationId} {
      // Anyone can create a registration (public form)
      allow create: if true;
      // Only admins can read, update, or delete registrations
      allow read, update, delete: if isAdmin();
    }

    // SPONSORSHIP ENQUIRIES COLLECTION
    match /sponsorshipEnquiries/{enquiryId} {
      // Anyone can submit an enquiry
      allow create: if true;
      // Only admins can read, update, or delete enquiries
      allow read, update, delete: if isAdmin();
    }

    // PUBLIC CONTENT COLLECTIONS
    // Anyone can read, but only admins can write
    
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteContent/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /eventConfig/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}